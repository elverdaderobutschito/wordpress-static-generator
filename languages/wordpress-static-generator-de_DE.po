msgid "Static Deploy – Settings"
msgstr "Static Deploy"

#: includes/class-wpstatic-settings.php:548
msgid "You have unsaved changes."
msgstr "Du hast ungespeicherte Änderungen."

#: includes/class-wpstatic-settings.php:549
