#: includes/class-wpstatic-netlify-uploader.php:20
msgid "Netlify Site ID or token is missing from the settings."
msgstr "Netlify Site-ID oder Token fehlt in den Einstellungen."

#: includes/class-wpstatic-netlify-uploader.php:58
#, php-format
msgid "Could not reach Netlify: %s"
msgstr "Konnte Netlify nicht erreichen: %s"

#: includes/class-wpstatic-netlify-uploader.php:65
msgid ""
"Netlify token invalid or expired. Please enter a new Personal Access Token."
msgstr ""
"Netlify-Token ungültig oder abgelaufen. Bitte neuen Personal Access Token "
"eintragen."

#: includes/class-wpstatic-netlify-uploader.php:69
#, php-format
msgid ""
"No Netlify site found with the ID \"%s\". Please check the site ID (found "
"under Site settings -> General -> Site details in Netlify)."
msgstr ""
"Keine Netlify-Site mit der ID \"%s\" gefunden. Bitte Site-ID prüfen (zu "
"finden unter Site settings -> General -> Site details in Netlify)."

#: includes/class-wpstatic-netlify-uploader.php:73
#, php-format
msgid "Netlify responded with HTTP %d."
msgstr "Netlify antwortete mit HTTP %d."

#: includes/class-wpstatic-netlify-uploader.php:79
msgid "Unexpected response from Netlify - please check the site ID."
msgstr "Unerwartete Antwort von Netlify - bitte Site-ID prüfen."

#: includes/class-wpstatic-netlify-uploader.php:89
msgid ""
"Netlify does not support single-file transfer - please use uploadDirectory()."
msgstr ""
"Netlify unterstützt keine Einzeldatei-Übertragung - bitte uploadDirectory() "
"verwenden."

#: includes/class-wpstatic-netlify-uploader.php:97
msgid "Could not zip the build directory for the Netlify deploy."
msgstr "Konnte Build-Verzeichnis nicht für den Netlify-Deploy zippen."

#: includes/class-wpstatic-netlify-uploader.php:113
msgid "Could not read the ZIP file for the Netlify deploy."
msgstr "Konnte ZIP-Datei für den Netlify-Deploy nicht lesen."

#: includes/class-wpstatic-netlify-uploader.php:134
#, php-format
msgid "Netlify deploy failed: %s"
msgstr "Netlify-Deploy fehlgeschlagen: %s"

#: includes/class-wpstatic-netlify-uploader.php:143
#, php-format
msgid "Netlify responded with HTTP %1$d: %2$s"
msgstr "Netlify antwortete mit HTTP %1$d: %2$s"

#: includes/class-wpstatic-assets-manager.php:71
msgid "The PHP zip extension is not active."
msgstr "PHP-zip-Erweiterung ist nicht aktiv."

#: includes/class-wpstatic-assets-manager.php:77
msgid "The ZIP file could not be opened."
msgstr "ZIP-Datei konnte nicht geöffnet werden."

#: includes/class-wpstatic-assets-manager.php:93
msgid ""
"The ZIP file does not contain an \"assets/\" folder as its root. Please zip "
"the assets folder itself (not just its contents)."
msgstr ""
"Die ZIP-Datei enthält kein \"assets/\"-Verzeichnis als Wurzelordner. Bitte "
"den assets-Ordner selbst zippen (nicht nur seinen Inhalt)."

#: includes/class-wpstatic-assets-manager.php:102
msgid "Could not create a temporary directory."
msgstr "Konnte temporäres Verzeichnis nicht anlegen."

#: includes/class-wpstatic-assets-manager.php:110
msgid "Extracting the ZIP file failed."
msgstr "Export fehlgeschlagen: ZIP-Datei wurde nicht erzeugt."

#: includes/class-wpstatic-assets-manager.php:117
msgid "No \"assets/\" folder found after extraction."
msgstr "Nach dem Entpacken wurde kein \"assets/\"-Verzeichnis gefunden."

#: includes/class-wpstatic-assets-manager.php:140
msgid "Could not move assets to the target location."
msgstr "Konnte Assets nicht an den Zielort verschieben."

#: includes/class-wpstatic-assets-manager.php:151
msgid "Assets updated successfully."
msgstr "Assets erfolgreich aktualisiert."

#: includes/class-wpstatic-sftp-uploader.php:22
msgid ""
"phpseclib3 was not found. Please run \"composer install\" in the plugin "
"directory (see README.md) or upload the vendor folder manually."
msgstr ""
"phpseclib3 wurde nicht gefunden. Bitte \"composer install\" im Plugin-"
"Verzeichnis ausführen (siehe README.md) oder den vendor-Ordner manuell "
"hochladen."

#: includes/class-wpstatic-sftp-uploader.php:27
msgid "No host specified."
msgstr "Kein Host angegeben."

#: includes/class-wpstatic-sftp-uploader.php:45
#, php-format
msgid ""
"Could not connect to %1$s:%2$s. Please check host, port and firewall/network."
msgstr ""
"Konnte keine Verbindung zu %1$s:%2$s aufbauen. Bitte Host, Port und Firewall/"
"Netzwerk prüfen."

#: includes/class-wpstatic-sftp-uploader.php:53
msgid ""
"Connected to the server, but login failed. Please check the username and"
msgstr ""
"Verbindung zum Server hergestellt, aber Login fehlgeschlagen. Bitte "
"Benutzername und"

#: includes/class-wpstatic-sftp-uploader.php:54
msgid "private key/passphrase"
msgstr "Privater Schlüssel"

#: includes/class-wpstatic-sftp-uploader.php:54
msgid "password"
msgstr "Passwort"

#: includes/class-wpstatic-sftp-uploader.php:82
#, php-format
msgid ""
"Target directory \"%s\" could not be created/found. Please check the path "
"and permissions of the SFTP user."
msgstr ""
"Zielverzeichnis \"%s\" konnte nicht angelegt/gefunden werden. Bitte Pfad und "
"Rechte des SFTP-Nutzers prüfen."

#: includes/class-wpstatic-sftp-uploader.php:92
#, php-format
msgid "\"%s\" exists, but is not a directory. Please check the path."
msgstr "\"%s\" existiert, ist aber kein Verzeichnis. Bitte Pfad prüfen."

#: includes/class-wpstatic-sftp-uploader.php:104
#, php-format
msgid ""
"Connection/login successful, but \"%1$s\" is not writable (%2$s). Please "
"check the directory permissions for the SFTP user."
msgstr ""
"Verbindung/Login erfolgreich, aber \"%1$s\" ist nicht beschreibbar (%2$s). "
"Bitte Verzeichnis-Rechte für den SFTP-Nutzer prüfen."

#: includes/class-wpstatic-sftp-uploader.php:126
#, php-format
msgid "Could not transfer file via SFTP: %1$s (%2$s)"
msgstr "Konnte Datei nicht per SFTP übertragen: %1$s (%2$s)"

